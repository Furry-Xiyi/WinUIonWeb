{
  "name": "winuionweb",
  "version": "0.1.0",
  "description": "WinUI-style Vue 3 components for the web",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Furry-Xiyi/WinUIonWeb.git",
    "directory": "WinUIonWeb"
  },
  "homepage": "https://furry-xiyi.github.io/WinUIonWeb/",
  "keywords": ["vue", "vue3", "winui", "components", "xaml"],
  "type": "module",
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/types/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./style.css": "./dist-lib/style.css"
  },
  "files": ["dist-lib", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md", "docs/icon-font.md"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "dev": "vite . --host=0.0.0.0",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && vue-tsc -p tsconfig.lib.json --declaration --emitDeclarationOnly && node scripts/finalize-library-types.mjs && npm run verify:lib",
    "verify:lib": "node scripts/check-library-package.mjs",
    "prepack": "npm run build:lib",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache"
  },
  "dependencies": {
    "mathlive": "^0.111.0",
    "rtf.js": "^3.0.9"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.2.1",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.60.0",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vue-tsc": "^3.2.6",
    "vue": "^3.5.32",
    "vue-router": "^4.6.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
